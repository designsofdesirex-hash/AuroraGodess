{
  "schemaVersion": 1,
  "packageDate": "2026-10-09",
  "brand": {
    "wordmark": "AURORA",
    "displayName": "AuroraGodess"
  },
  "siteUrl": null,
  "currency": "USD",
  "buildMode": "preview",
  "font": {
    "family": "Manrope",
    "path": "/assets/fonts/Manrope-Variable.woff2",
    "fallback": "Arial, sans-serif",
    "runtimeExternalLoading": false
  },
  "constraints": {
    "staticOnly": true,
    "backend": false,
    "hostedBookingForm": false,
    "paymentProcessing": false,
    "analytics": false
  },
  "ageEntry": {
    "minimumAge": 18,
    "storage": "sessionStorage",
    "storageKey": "aurora:adult-entry:v1",
    "storageValue": "accepted",
    "ungatedRoutes": [
      "/privacy",
      "/exit"
    ]
  },
  "routes": [
    {
      "path": "/",
      "output": "index.html",
      "title": "AuroraGodess — Official Website",
      "description": "Step into Aurora’s world. Explore selected photographs, find her official pages, or prepare a booking request.",
      "noindex": false
    },
    {
      "path": "/booking",
      "output": "booking/index.html",
      "title": "Request My Time — AuroraGodess",
      "description": "Prepare a booking request for Aurora with your preferred timing. Pricing is in USD; requests require a personal reply.",
      "noindex": true
    },
    {
      "path": "/gallery",
      "output": "gallery/index.html",
      "title": "Selected Frames — AuroraGodess",
      "description": "A curated selection of Aurora’s approved photographs.",
      "noindex": false
    },
    {
      "path": "/links",
      "output": "links/index.html",
      "title": "Official Links — AuroraGodess",
      "description": "Aurora’s LoyalFans, Throne, X, YouPay and Cash App destinations in one place.",
      "noindex": false
    },
    {
      "path": "/policies",
      "output": "policies/index.html",
      "title": "Booking Information — AuroraGodess",
      "description": "How Aurora’s booking request process works, with pricing in USD.",
      "noindex": true
    },
    {
      "path": "/privacy",
      "output": "privacy/index.html",
      "title": "Privacy — AuroraGodess",
      "description": "How the static website handles entry choices and booking drafts.",
      "noindex": false
    },
    {
      "path": "/exit",
      "output": "exit/index.html",
      "title": "Exit — AuroraGodess",
      "description": "You have left Aurora’s website.",
      "noindex": true
    }
  ],
  "booking": {
    "mode": "static-request",
    "contactEmail": null,
    "offers": [],
    "generalPriceText": "Pricing confirmed by email · USD",
    "mailtoUriBudget": 1800,
    "noteMaxLength": 1000,
    "aliasMaxLength": 60,
    "downloadFilename": "aurora-booking-request.txt"
  },
  "gallery": {
    "initialGridCount": 8,
    "revealCount": 8,
    "filterMinimumGridAssets": 8,
    "categories": [
      "portraits",
      "details",
      "motion"
    ],
    "leadAssetId": "galleryLead"
  },
  "links": [
    {
      "id": "loyalfans",
      "url": "https://www.loyalfans.com/godessaurora02",
      "enabled": true,
      "labelKey": "destinations.loyalfans",
      "purpose": "creator-page"
    },
    {
      "id": "throne",
      "url": "https://throne.com/godessaurora02",
      "enabled": true,
      "labelKey": "destinations.throne",
      "purpose": "wishlist"
    },
    {
      "id": "x",
      "url": "https://x.com/Auroragodess02/media",
      "enabled": true,
      "labelKey": "destinations.x",
      "purpose": "social"
    },
    {
      "id": "youpay",
      "url": "https://youpay.me/GodessAurora287",
      "enabled": true,
      "labelKey": "destinations.youpay",
      "purpose": "support"
    },
    {
      "id": "cashapp",
      "url": "https://cash.app/$GodessAuroraa",
      "enabled": true,
      "labelKey": "destinations.cashapp",
      "purpose": "support"
    }
  ],
  "ownerInputs": {
    "contactEmail": "required",
    "siteUrl": "required",
    "approvedPhotoAssignments": "required",
    "offers": "optional; general-request mode is valid without a catalogue",
    "cashAppRecipientChecked": false,
    "youPayRecipientChecked": false
  }
}
